<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bookshop.mapper.UserMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user (username, password, role, balance)
        VALUES (#{username}, #{password}, #{role}, #{balance})
    </insert>

    <select id="findByUsername" resultType="com.example.bookshop.entity.User">
        SELECT * FROM t_user WHERE username = #{username}
    </select>

    <select id="findById" resultType="com.example.bookshop.entity.User">
        SELECT * FROM t_user WHERE id = #{id}
    </select>

    <update id="deductBalance">
        UPDATE t_user SET balance = balance - #{amount}
        WHERE id = #{id} AND balance &gt;= #{amount}
    </update>

    <delete id="deleteById">
        DELETE FROM t_user WHERE id = #{id}
    </delete>
</mapper>
